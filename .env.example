# Any OpenAI-compatible endpoint (OpenAI, vLLM, Ollama, LM Studio, ...)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
CHAT_MODEL=gpt-4o-mini
# Embeddings endpoint on the same base URL. If the server has no embeddings
# endpoint the app falls back to a local hashed embedding so the demo still runs.
EMBED_MODEL=text-embedding-3-small


# FalkorDB (default: the instance already running on this machine)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
GRAPH_NAME=hackthepatch

# STORE=memory runs without FalkorDB (tests / quick UI checks). Default: falkordb
STORE=falkordb

# LinkedIn "Sign In with LinkedIn using OpenID Connect" app (https://www.linkedin.com/developers/)
# Redirect URL registered on the app must equal LINKEDIN_REDIRECT_URI.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/callback
# Add r_basicprofile only if LinkedIn granted it to your app; it lets the login read the profile URL
# (vanity name) and store it on the profile at login. Default scopes give name/email/picture.
LINKEDIN_SCOPES=openid profile email
# Member Data Portability (EU/EEA + Switzerland members only): add the "Member Data Portability API (Member)"
# product to the app and append r_dma_portability_self_serve to LINKEDIN_SCOPES. The login then reads
# positions, education and skills with the member's consent for that attendee.
SESSION_SECRET=change-me
# DEV_LOGIN=true enables POST /auth/dev-login {name} to test the profile page without a LinkedIn app.
DEV_LOGIN=false
